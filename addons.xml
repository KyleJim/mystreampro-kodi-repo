<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="repository.mystreampro" name="MyStreamPro Repository" version="1.0.0" provider-name="MSP">
  <extension point="xbmc.addon.repository">
    <dir>
      <info>https://kylejim.github.io/mystreampro-kodi-repo/addons.xml</info>
      <checksum>https://kylejim.github.io/mystreampro-kodi-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://kylejim.github.io/mystreampro-kodi-repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>MyStreamPro Kodi add-on repository</summary>
    <description>Install and update MyStreamPro.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon><addon id="plugin.video.mystreampro" name="MyStreamPro" version="1.0.2" provider-name="MSP">
  <requires><import addon="xbmc.python" version="3.0.0" /></requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup" />
  <extension point="xbmc.addon.metadata">
    <summary>MyStreamPro movies, TV series and Chinese Live TV</summary>
    <description>Adds six Chinese Live TV channels with backup stream failover.</description>
    <assets><icon>icon.png</icon></assets>
    <platform>all</platform><license>MIT</license><language>en</language>
  </extension>
</addon></addons>